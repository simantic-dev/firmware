<screen permanent="true">
	<styles>
		<style name="style_bar_ind" bg_color="0xffffff" />
	</styles>

	<view extends="lv_obj" style_bg_color="0x000000">
		<style name="style_scrollbar" selector="scrollbar" />

		<column height="100%" width="100%">
			<lv_bar
				height="50"
				width="100%"
				bind_value="subject_torque_percent"
				style_bg_color="0x000000"
				style_arc_color="0xffffff"
			>
				<style name="style_bar_ind" selector="indicator" />
			</lv_bar>

			<row
				horizontal_align="center"
				width="100%"
				style_pad_top="50"
				style_pad_bottom="50"
			>
				<h1
					bind_text="subject_wheel_speed"
					bind_text-fmt="%d%"
					style_text_font="font_guage_lg"
					style_text_color="0xffffff"
				/>
			</row>

			<row horizontal_align="center" width="100%">
				<button text="other page">
					<screen_create_event
						screen="screen_components"
						trigger="clicked"
						anim_type="move_left"
						duration="2000"
					/>
				</button>
			</row>
		</column>
	</view>
</screen>
