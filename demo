#!/bin/sh
# FEB SN5 car: the unmodified firmware on six simulated STM32F446RE boards on one CAN bus (sim/scenario.yaml).
# ./demo [seconds]  run it (default 6.5 virtual s; needs sim on PATH, mtools, and the built images)
# ./demo build      build the images first (arm-none-eabi-gcc, cmake, ninja)
set -eu
cd "$(dirname "$0")"
if [ "${1:-}" = build ]; then exec sh sim/build.sh; fi
SIM="${SIM:-sim}"
command -v "$SIM" >/dev/null || { echo "sim not found. Install it: curl -fsSL https://simantic.com/install | sh" >&2; exit 1; }
command -v mformat >/dev/null || { echo "mformat not found: install mtools (the DCU's SD card image)" >&2; exit 1; }
[ -f build/Debug/BMS/BMS.elf ] || { echo "not built yet: ./demo build" >&2; exit 1; }
cd sim # the scenario's elf, peer and overlay paths resolve against sim/
mkdir -p out
# The DCU's SD card: an empty 32 MB FAT16 volume, rebuilt on every run (same as sim/run.sh).
truncate -s 32M out/dcu-sd.img
mformat -i out/dcu-sd.img -T 65536 -h 16 -s 63 -c 2 -v DCU ::
# Every value printed is decoded from a CAN frame a board sent (layouts: common/FEB_CAN_Library_SN4/gen/FEB_CAN.dbc,
# scales from the firmware's pack calls) or is a line the firmware printed on its console. Raw stream: sim/out/demo.log.
"$SIM" run --scenario scenario.yaml --timeout "${1:-6.5}" --ascii --frames-only can --frames /dev/stdout 2>out/demo.err \
  | tee out/demo.log \
  | awk '
  function hx(s,   i, v) { v = 0; for (i = 1; i <= length(s); i++) v = v * 16 + index("0123456789ABCDEF", substr(s, i, 1)) - 1; return v }
  function le(i,   v) { v = hx(b[i + 1] b[i]); return v }                     # uint16 little-endian at byte i
  function sle(i,   v) { v = le(i); return v >= 32768 ? v - 65536 : v }
  function be(i) { return hx(b[i] b[i + 1]) }                                # uint16 big-endian at byte i
  function state(n) { return n == 0 ? "BOOT" : n == 1 ? "LV_POWER" : n == 2 ? "BUS_HEALTH_CHECK" : n == 3 ? "PRECHARGE" : n == 4 ? "ENERGIZED" : n == 5 ? "DRIVE" : n == 10 ? "FAULT_BMS" : "state " n }
  function say(who, what) { printf "%6.2fs  %-5s  %s\n", t, who, what; fflush() }
  function fw(who,   m) {                                                    # a line the firmware printed, tidied
    m = $0; sub(/^.*\) /, "", m); gsub(/\.\[[0-9;]*m/, "", m); sub(/^\[[0-9]+\] [A-Z] /, "", m); sub(/ \([A-Za-z_0-9]+\.c:[0-9]+\)$/, "", m)
    say(who, "console: " m)
  }
  { t = substr($2, 2) + 0 }
  $4 != "CAN" {
    if ($1 == "[bms]") {
      if (/BOOT -> LV_POWER|\[SM\] LV_POWER -> |Shutdown open during health check|IVT current-sensor timeout|FAULT ENTRY/) fw("BMS")
      if (/Pack Voltage: / && !st) { st = 1; pk = $NF }
      if (/Min Cell \(C\/S\)/ && st == 1) mn = $(NF - 2)
      if (/Max Cell \(C\/S\)/ && st == 1) mx = $(NF - 2)
      if (/Min Temp: / && st == 1) { st = 2; say("BMS", "console BMS|status: pack " pk ", cells " mn " to " mx ", temp " $(NF - 5) " to " $(NF - 2)) }
      if (/=== Cell Voltages/) { nc = 0; lo = 99; hi = 0 }
      if ($(NF - 1) ~ /^C[0-9][0-9]:$/) {
        v = $NF + 0; nc++; if (v < lo) lo = v; if (v > hi) hi = v
        if (nc == 140) say("BMS", sprintf("console BMS|cells: 140 cells read over SPI1 from 10 ADBMS6830B, %.3f V to %.3f V", lo, hi))
      }
    }
    if ($1 == "[pcu]" && /PCU Setup Complete/) say("PCU", "console: PCU Setup Complete (8/8 steps)")
    if ($1 == "[lvpdb]" && /TPS init: /) fw("LVPDB")
    if ($1 == "[dcu]" && /Logging to /) fw("DCU")
    if ($1 == "[front]" && /Gyro auto-cal done/) say("FRONT", "console: Gyro auto-cal done (REAR prints the same)")
    next
  }
  $5 == "Tx" {
    frames++; id = substr($6, 4); sub(/^data=/, "", $8); for (i = 8; i <= NF; i++) b[i - 8] = $i
    if (id == "0x2" && le(0)) { pack = le(0) / 10; cmin = le(2) / 10; cmax = le(4) / 10 }
    if (id == "0x3" && le(0)) { tavg = sle(0) / 10; tmax = sle(4) / 10 }
    if (id == "0x5" && (hx(b[0]) % 32) != bst) {
      bst = hx(b[0]) % 32
      say("BMS", "CAN 0x5 bms_state: " state(bst) (pack ? sprintf(" | 0x2 pack %.1f V, cells %.1f to %.1f V | 0x3 avg %.1f C, hottest %.1f C", pack, cmin, cmax, tavg, tmax) : ""))
    }
    if (id == "0x10" && b[0] != dsw) { dsw = b[0]; say("DASH", "CAN 0x10 dash_state (stand-in peer): switch1 " (int(hx(dsw) / 16) % 2 ? "on" : "off") ", switch2 " (int(hx(dsw) / 32) % 2 ? "on" : "off")) }
    if (id == "0x16") { v24 = le(0) / 1000; v12 = le(2) / 1000 }
    if (id == "0x17") { c0 = le(0); c1 = le(2); c2 = le(4); c3 = le(6) }
    if (id == "0x18" && (lv ? le(2) - af > 2000 : t >= 2)) {
      lv = 1; af = le(2)
      say("LVPDB", sprintf("CAN 0x16-0x18: rails %.2f V, %.2f V | LV %.2f SH %.2f LT %.2f BM_L %.2f SM %.2f fans %.2f pump %.2f A", v24, v12, c0 / 1000, c1 / 1000, c2 / 1000, c3 / 1000, le(0) / 1000, af / 1000, le(4) / 1000))
    }
    if (id == "0x26" && !imu) { imu = 1; say("FRONT", sprintf("CAN 0x26 imu_acceleration: x %.0f, y %.0f, z %.0f mg", sle(0) * 0.061, sle(2) * 0.061, sle(4) * 0.061)) }
    if (id == "0xC0") { tq = sle(0) / 10; en = hx(b[5]) % 2 }
    if (id == "0x38") {
      thr = be(4) / 100
      if (thr != pthr && t >= nxt) {
        pthr = thr; nxt = t + 0.5
        say("PCU", sprintf("CAN 0x38 throttle %.1f %% (APPS %.1f / %.1f %%) | 0xC0 torque command %.1f Nm, inverter %s", thr, be(0) / 100, be(2) / 100, tq, en ? "enabled" : "disabled"))
      }
    }
  }
  END {
    if (bst == "") { print "no bms_state frame seen: see sim/out/demo.log and sim/out/demo.err"; exit 1 }
    printf "done: %.1f virtual s, %d CAN frames | BMS %s, pack %.1f V, hottest %.1f C | throttle %.1f %%, torque %.1f Nm\n", t, frames, state(bst), pack, tmax, thr, tq
  }'
