function(feb_target_mcu target core)
    if(core STREQUAL "M4")
        set(flags -mcpu=cortex-m4 -mfpu=fpv4-sp-d16 -mfloat-abi=hard)
    elseif(core STREQUAL "M33")
        set(flags -mcpu=cortex-m33 -mfpu=fpv5-sp-d16 -mfloat-abi=hard)
    else()
        message(FATAL_ERROR "feb_target_mcu: unknown core '${core}' for ${target} (expected M4 or M33)")
    endif()

    get_target_property(type ${target} TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY")
        set(scope INTERFACE)
    else()
        set(scope PUBLIC)
    endif()

    target_compile_options(${target} ${scope} ${flags})
    if(type STREQUAL "EXECUTABLE")
        target_link_options(${target} PRIVATE ${flags})
    endif()
endfunction()
